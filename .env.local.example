# Supabase — get these from your Supabase project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_SECRET_KEY=

# Postgres — Supabase project Settings > Database > Connection String
# Use Transaction pooler URL for runtime (port 6543)
# Use Session pooler URL for migrations (port 5432)
DATABASE_URL=

# AI — Anthropic console (console.anthropic.com)
ANTHROPIC_API_KEY=

# Email — Resend (resend.com) API key for transactional emails
RESEND_API_KEY=

# CI / lint — set to "true" in CI environments without real credentials
# SKIP_ENV_VALIDATION=true

# Local workflow tracing — writes NDJSON to .exitiq-debug/workflow.ndjson
# Never active on Vercel (guarded internally). Safe to leave "false" in production.
# EXITIQ_WORKFLOW_LOG=true
# NEXT_PUBLIC_EXITIQ_WORKFLOW_LOG=true

# Public site — canonical origin used for metadataBase, sitemap.xml, and robots.txt
# NEXT_PUBLIC_SITE_URL=https://heirloom.com
