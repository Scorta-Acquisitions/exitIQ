# Supabase — get these from your Supabase project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_SECRET_KEY=

# Postgres — Supabase project Settings > Database > Connection String
# Use Transaction pooler URL for runtime (port 6543)
# Use Session pooler URL for migrations (port 5432)
DATABASE_URL=

# AI — Anthropic console (console.anthropic.com)
ANTHROPIC_API_KEY=

# Email — Resend (resend.com) API key for transactional emails
RESEND_API_KEY=

# CI / lint — set to "true" in CI environments without real credentials
# SKIP_ENV_VALIDATION=true
