{
  "name": "next-enterprise",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "cross-env FORCE_COLOR=1 next dev --turbo",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "node node_modules/typescript/bin/tsc --noEmit --watch",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "prettier": "prettier --check \"**/*.{js,jsx,ts,tsx}\"",
    "prettier:fix": "prettier --write \"**/*.{js,jsx,ts,tsx}\"",
    "analyze": "cross-env ANALYZE=true pnpm run build",
    "test": "cross-env FORCE_COLOR=1 RUN_DB_INTEGRATION_TESTS=1 vitest",
    "test:site": "cross-env FORCE_COLOR=1 SKIP_ENV_VALIDATION=true vitest run --config vitest.site.config.ts --coverage",
    "test:integration": "cross-env FORCE_COLOR=1 RUN_DB_INTEGRATION_TESTS=1 vitest run lib/db/__tests__/assessment-schema.int.test.ts lib/db/__tests__/assessment-rls.int.test.ts",
    "test:watch": "cross-env FORCE_COLOR=1 RUN_DB_INTEGRATION_TESTS=1 vitest --watch",
    "test:ui": "cross-env FORCE_COLOR=1 RUN_DB_INTEGRATION_TESTS=1 vitest --ui",
    "test:coverage": "cross-env FORCE_COLOR=1 RUN_DB_INTEGRATION_TESTS=1 vitest --coverage",
    "e2e:headless": "playwright test",
    "e2e:ui": "playwright test --ui",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "coupling-graph": "npx madge --extensions js,jsx,ts,tsx,css,md,mdx ./ --exclude '.next|tailwind.config.js|reset.d.ts|prettier.config.js|postcss.config.js|playwright.config.ts|next.config.js|next-env.d.ts|instrumentation.ts|e2e/|README.md|.storybook/|.eslintrc.js' --image graph.svg",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.69",
    "@next/bundle-analyzer": "^15.3.1",
    "@next/env": "15.5.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.0",
    "@t3-oss/env-nextjs": "^0.13.10",
    "@vercel/otel": "^1.12.0",
    "ai": "^6.0.160",
    "class-variance-authority": "^0.7.1",
    "drizzle-orm": "^0.45.2",
    "next": "15.5.10",
    "postgres": "^3.4.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "resend": "^6.12.2",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "15.1.6",
    "@opentelemetry/api": "1.7.0",
    "@opentelemetry/resources": "1.18.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.26.0",
    "eslint-config-next": "15.1.6",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.8",
    "postcss-import": "^16.1.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.1",
    "typed-query-selector": "^2.12.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "overrides": {
      "tmp@<=0.2.3": ">=0.2.4"
    }
  }
}
